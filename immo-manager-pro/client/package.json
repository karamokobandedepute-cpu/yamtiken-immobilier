{
  "name": "immo-manager-pro-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs",
    "electron:build": "cross-env VITE_API_URL=http://localhost:5000/api vite build && electron-builder",
    "electron:pack": "cross-env VITE_API_URL=http://localhost:5000/api vite build && electron-builder --dir",
    "cap:build": "vite build",
    "cap:sync": "npm run cap:build && npx cap sync android",
    "cap:android": "npm run cap:sync && npx cap open android"
  },
  "build": {
    "appId": "com.yamtiken.immo",
    "productName": "YAMTIKEN Immobilier",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "public/icon-512.png"
    ],
    "asarUnpack": [
      "electron/splash.html"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!logs/**",
          "!uploads/**",
          "!**/*.log"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon-512.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@sentry/react": "^10.52.0",
    "@sentry/vite-plugin": "^5.2.1",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.6.7",
    "date-fns": "^3.3.1",
    "electron-serve": "^1.3.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.18.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.47.1",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
