# ============================================
# CONFIGURATION CLIENT - IMMO MANAGER PRO
# ============================================

# URL de l'API backend
VITE_API_URL=http://localhost:3000/api

# En production, remplacer par l'URL du serveur déployé
# VITE_API_URL=https://api.immomanagerpro.com/api

# Email du super administrateur (mode fantôme — ses actions ne sont pas tracées)
VITE_SUPER_ADMIN_EMAIL=munokolive@gmail.com

# ============================================
# SUPABASE - CRITIQUE pour le temps réel
# ============================================
# Ces variables sont OBLIGATOIRES pour le fonctionnement en temps réel
# Trouvez-les dans : Supabase Dashboard > Project Settings > API
#
# VITE_SUPABASE_URL : URL de votre projet Supabase
# - Format : https://[REF_PROJECT].supabase.co
# - Exemple : https://abc123xyz789.supabase.co
#
# VITE_SUPABASE_ANON_KEY : Clé anonyme publique
# - Cette clé est SÉCURISÉE à exposer côté client
# - Elle respecte les policies RLS définies dans Supabase
VITE_SUPABASE_URL=https://VOTRE_REF.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# ============================================
# SENTRY - MONITORING DES ERREURS
# ============================================
# Configuration pour le suivi des erreurs en production
# Créer un compte gratuit sur https://sentry.io
#
# VITE_SENTRY_DSN : Data Source Name de votre projet Sentry
# - Format : https://[KEY]@[ORG].ingest.sentry.io/[PROJECT_ID]
# - Trouvez-le dans : Sentry Dashboard > Settings > Projects > Client Keys (DSN)
# - Exemple : https://abc123@o123456.ingest.sentry.io/789012
#
# VITE_APP_VERSION : Version de l'application (pour tracking des releases)
# - Format : X.Y.Z (semantic versioning)
# - Exemple : 1.0.0
VITE_SENTRY_DSN=https://VOTRE_KEY@VOTRE_ORG.ingest.sentry.io/VOTRE_PROJECT_ID
VITE_APP_VERSION=1.0.0
