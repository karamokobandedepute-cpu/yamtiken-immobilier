{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2015",
    "moduleResolution": "bundler",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": [
    "client/src/**/*",
    "server/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/node_modules/**",
    "server/node_modules",
    "server/node_modules/**",
    "client/node_modules",
    "client/node_modules/**",
    "dist",
    "build"
  ]
}
