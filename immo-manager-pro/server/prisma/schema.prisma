generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  password         String
  nom              String
  prenom           String
  photoUrl         String?
  telephone        String?
  role             Role           @default(SECRETAIRE)
  actif            Boolean        @default(true)
  verified         Boolean        @default(false)
  dernierConnexion DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditLogs        AuditLog[]
  contratsCrees    Contrat[]      @relation("ContratCreePar")
  depenses       Depense[]
  
  facturesGenerees Facture[]
  notifications    Notification[]
  paiementsCrees   Paiement[]     @relation("PaiementCreePar")
  payments         Payment[]
  visitesCreees    Visite[]       @relation("VisiteCreePar")

  otp              Otp?

  @@map("users")
}

model Client {
  id                   Int                 @id @default(autoincrement())
  type                 TypeClient          @default(CLIENT)
  nom                  String?
  prenom               String?
  nationalite          String?             @default("Ivoirienne")
  dateNaissance        DateTime?
  telephone            String?
  telephone2           String?
  email                String?
  adresse              String?
  profession           String?
  numeroPiece          String?             @unique
  photoUrl             String?
  pieceUrl             String?
  temoinId             Int?
  isDemo               Boolean             @default(false) @map("is_demo")
  actif                Boolean             @default(true)
  deletedAt            DateTime?
    otp                  ClientOtp?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  password             String?
  scoreRisque          Float?
  niveauRisque         String?
  biensProprietaire    Bien[]              @relation("ProprietaireBiens")
  temoin               Referrer?           @relation(fields: [temoinId], references: [id])
  commissions          Commission[]
  contratsLocataire    Contrat[]           @relation("LocataireContrat")
  contratsProprietaire Contrat[]           @relation("ProprietaireContrat")
  documents            Document[]
  leases               Lease[]
  paiements            Paiement[]
  tickets              TicketMaintenance[]

  @@index([type])
  @@index([createdAt])
  @@index([nom])
  @@index([deletedAt])
  @@index([actif])
  @@map("clients")
}

model Referrer {
  id             Int            @id @default(autoincrement())
  nom            String
  prenom         String
  contact        String
  email          String?
  photoUrl       String?
  adresse        String?
  tauxCommission Float          @default(5.0)
  typeCommission TypeCommission @default(POURCENTAGE)
  isActive       Boolean        @default(true) @map("is_active")
  isDemo         Boolean        @default(false) @map("is_demo")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  clients        Client[]
  commissions    Commission[]

  @@map("referrers")
}

model Commission {
  id           Int              @id @default(autoincrement())
  referrerId   Int
  clientId     Int
  montant      Float
  datePaiement DateTime?
  statut       StatutCommission @default(EN_ATTENTE)
  description  String?
  isDemo       Boolean          @default(false) @map("is_demo")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  referrer     Referrer         @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([clientId])
  @@index([statut])
  @@map("commissions")
}

model Lease {
  id             Int         @id @default(autoincrement())
  numeroBail     String      @unique
  clientId       Int
  uniteId        Int
  buildingId     Int
  montantInitial Float
  caution        Float?
  droitsTerre    Float?
  chargesAnnexes Float?
  dateSignature  DateTime    @default(now())
  dateDebut      DateTime
  dateEntree     DateTime?
  dateLivraisonPrevue DateTime?
  cleRemise      Boolean   @default(false)
  dateRemiseCle  DateTime?
  dateFin        DateTime?
  statut         StatutLease @default(ACTIF)
  isDemo         Boolean     @default(false) @map("is_demo")
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  depenses       Depense[]
  factures       Facture[]
  etatsLieux     EtatLieux[]
  building       Building    @relation(fields: [buildingId], references: [id])
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unite          Unite       @relation(fields: [uniteId], references: [id])
  payments       Payment[]

  @@index([clientId])
  @@index([statut])
  @@index([buildingId])
  @@index([uniteId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([dateFin])
  @@map("leases")
}

model Payment {
  id            Int          @id @default(autoincrement())
  numeroFacture String       @unique
  leaseId       Int
  datePaiement  DateTime     @default(now())
  montantVerse  Float
  modePaiement  ModePaiement @default(ESPECES)
  agentId       Int
  notes         String?
  isDemo        Boolean      @default(false) @map("is_demo")
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  agent         User         @relation(fields: [agentId], references: [id])
  lease         Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
  @@index([datePaiement])
  @@index([agentId])
  @@index([deletedAt])
  @@map("payments")
}

model Facture {
  id             Int      @id @default(autoincrement())
  numeroFacture  String   @unique
  leaseId        Int
  clientId       Int
  contenu        String
  dateGeneration DateTime @default(now())
  agentId        Int
  agent          User     @relation(fields: [agentId], references: [id])
  lease          Lease    @relation(fields: [leaseId], references: [id])

  @@map("factures")
}

model Bien {
  id             Int                 @id @default(autoincrement())
  reference      String              @unique
  titre          String
  description    String?
  type           TypeBien
  statut         StatutBien          @default(DISPONIBLE)
  adresse        String
  ville          String
  quartier       String?
  codePostal     String?
  surface        Float?
  nbPieces       Int?
  nbChambres     Int?
  nbSallesBain   Int?
  etage          Int?
  prixLocation   Float?
  prixVente      Float?
  charges        Float?
  caution        Float?
  photos         String[]
  equipements    String[]
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  proprietaireId Int?
  proprietaire   Client?             @relation("ProprietaireBiens", fields: [proprietaireId], references: [id])
  contrats       Contrat[]
  documents      Document[]
  tickets        TicketMaintenance[]
  visites        Visite[]

  @@index([statut])
  @@index([type])
  @@index([createdAt])
  @@map("biens")
}

model Contrat {
  id                Int        @id @default(autoincrement())
  reference         String     @unique
  type              String
  statut            String     @default("EN_COURS")
  dateDebut         DateTime   @map("date_debut")
  dateFin           DateTime?  @map("date_fin")
  dateSignature     DateTime   @default(now()) @map("date_signature")
  montantLoyer      Float?     @map("montant_loyer")
  montantVente      Float?     @map("montant_vente")
  frequencePaiement String?    @default("MENSUEL") @map("frequence_paiement")
  conditions        String?
  indexation        Boolean    @default(false)
  tauxIndexation    Float?     @map("taux_indexation")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  bienId            Int        @map("bien_id")
  locataireId       Int        @map("locataire_id")
  proprietaireId    Int        @map("proprietaire_id")
  creeParId         Int        @map("cree_par_id")
  bien              Bien       @relation(fields: [bienId], references: [id])
  creePar           User       @relation("ContratCreePar", fields: [creeParId], references: [id])
  locataire         Client     @relation("LocataireContrat", fields: [locataireId], references: [id])
  proprietaire      Client     @relation("ProprietaireContrat", fields: [proprietaireId], references: [id])
  documents         Document[]
  paiements         Paiement[]

  @@index([statut])
  @@index([type])
  @@index([createdAt])
  @@map("contrats")
}

model Paiement {
  id                   Int       @id @default(autoincrement())
  reference            String    @unique
  montant              Float
  datePaiement         DateTime  @default(now()) @map("date_paiement")
  periodeDebut         DateTime? @map("periode_debut")
  periodeFin           DateTime? @map("periode_fin")
  modePaiement         String    @default("VIREMENT") @map("mode_paiement")
  statut               String    @default("EN_ATTENTE")
  referenceTransaction String?   @map("reference_transaction")
  commentaire          String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  contratId            Int       @map("contrat_id")
  locataireId          Int       @map("locataire_id")
  creeParId            Int       @map("cree_par_id")
  contrat              Contrat   @relation(fields: [contratId], references: [id])
  creePar              User      @relation("PaiementCreePar", fields: [creeParId], references: [id])
  locataire            Client    @relation(fields: [locataireId], references: [id])

  @@index([statut])
  @@index([contratId])
  @@index([locataireId])
  @@index([datePaiement])
  @@map("paiements")
}

model Visite {
  id             Int           @id @default(autoincrement())
  dateVisite     DateTime      @default(now())
  nomVisiteur    String
  prenomVisiteur String
  contact        String
  email          String?
  bienVisiteId   Int
  motif          MotifVisite   @default(DECOUVERTE)
  responsable    String?
  compteRendu    String?
  relanceSouhait Boolean       @default(false)
  dateRelance    DateTime?
  statutRelance  StatutRelance @default(EN_ATTENTE)
  isDemo         Boolean       @default(false) @map("is_demo")
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  creeParId      Int?
  bienVisite     Bien          @relation(fields: [bienVisiteId], references: [id])
  creePar        User?         @relation("VisiteCreePar", fields: [creeParId], references: [id])

  @@index([bienVisiteId])
  @@index([statutRelance])
  @@index([dateRelance])
  @@map("visites")
}

model Alerte {
  id             Int        @id @default(autoincrement())
  type           TypeAlerte
  titre          String
  description    String
  referenceId    Int?
  referenceType  String?
  dateEcheance   DateTime
  estLue         Boolean    @default(false)
  estTraitee     Boolean    @default(false)
  dateTraitement DateTime?
  emailEnvoye    Boolean    @default(false)
  dateEnvoiEmail DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([type])
  @@index([estTraitee])
  @@index([dateEcheance])
  @@map("alertes")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  titre     String
  message   String
  type      String   @default("INFO")
  estLue    Boolean  @default(false)
  lien      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estLue])
  @@map("notifications")
}

model Document {
  id          Int      @id @default(autoincrement())
  nom         String
  type        String   @default("PDF")
  chemin      String
  taille      Int?
  description String?
  categorie   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientId    Int?
  bienId      Int?
  contratId   Int?
  bien        Bien?    @relation(fields: [bienId], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id])
  contrat     Contrat? @relation(fields: [contratId], references: [id])

  @@map("documents")
}

model Relance {
  id            Int      @id @default(autoincrement())
  type          String
  destinataire  String
  message       String
  dateEnvoi     DateTime @default(now()) @map("date_envoi")
  statut        String   @default("ENVOYE")
  referenceId   Int?     @map("reference_id")
  referenceType String?  @map("reference_type")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("relances")
}

model Building {
  id              Int          @id @default(autoincrement())
  nom             String
  type            TypeBuilding
  adresse         String
  commune         String
  ville           String       @default("Abidjan")
  nombreEtages    Int          @default(1)
  valeurEstimee   Float?
  droitsTerre     String?
  chargesAnnexes  Float?
  dateAcquisition DateTime?
  notes           String?
  isDemo          Boolean      @default(false) @map("is_demo")
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  leases          Lease[]
  unites       Unite[]
  depenses     Depense[]

  @@index([deletedAt])
  @@map("buildings")
}

model Unite {
  id          Int         @id @default(autoincrement())
  numeroPorte String
  typeUnite   TypeUnite
  etage       Int         @default(0)
  loyerBase   Float
  statut      StatutUnite @default(VACANT)
  isDemo      Boolean     @default(false) @map("is_demo")
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  buildingId  Int
  leases      Lease[]
  building    Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
  @@index([statut])
  @@map("unites")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  tableName String
  recordId  Int
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Depense {
  id           Int       @id @default(autoincrement())
  designation  String
  motif        String?
  categorie    String
  montant      Float
  date         DateTime  @default(now())
  description  String?
  reference    String?
  fournisseur  String?
  statut       String?
  modePaiement String?
  notes        String?
  createdById  Int       @map("created_by_id")
  leaseId      Int?      @map("lease_id")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    User      @relation(fields: [createdById], references: [id])
  lease        Lease?    @relation(fields: [leaseId], references: [id])
  buildingId   Int?      @map("building_id")
  building     Building? @relation(fields: [buildingId], references: [id])

  @@index([categorie])
  @@index([date])
  @@index([createdById])
  @@index([deletedAt])
  @@map("depenses")
}

model TicketMaintenance {
  id          Int          @id @default(autoincrement())
  titre       String
  description String
  statut      StatutTicket @default(NOUVEAU)
  urgence     String       @default("NORMALE")
  clientId    Int
  bienId      Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bien        Bien?        @relation(fields: [bienId], references: [id])
  client      Client       @relation(fields: [clientId], references: [id])

  @@map("tickets_maintenance")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SECRETAIRE
  AGENT_RECOUVREMENT
  DIRECTION
}

enum TypeBien {
  APPARTEMENT
  MAISON
  VILLA
  STUDIO
  BUREAU
  COMMERCE
  ENTREPOT
  TERRAIN
}

enum StatutBien {
  DISPONIBLE
  LOUE
  VENDU
  EN_RENOVATION
  RESERVE
}

enum TypeContrat {
  LOCATION
  VENTE
}

enum StatutContrat {
  ACTIF
  RESILIE
  TERMINE
  EN_COURS
}

enum StatutPaiement {
  PAYE
  EN_RETARD
  PARTIEL
  EN_ATTENTE
}

enum TypeClient {
  SOUSCRIPTEUR
  CLIENT
}

enum TypeCommission {
  FIXE
  POURCENTAGE
}

enum StatutCommission {
  EN_ATTENTE
  PAYEE
}

enum StatutLease {
  ACTIF
  TERMINE
  RESILIE
}

enum ModePaiement {
  ESPECES
  VIREMENT
  MOBILE_MONEY
  CHEQUE
}

enum MotifVisite {
  DECOUVERTE
  NEGOCIATION
  RECLAMATION
  AUTRE
}

enum StatutRelance {
  EN_ATTENTE
  EFFECTUEE
  ANNULEE
}

enum TypeAlerte {
  PAIEMENT_ECHEANCE
  BAIL_EXPIRATION
  RELANCE_VISITE
  GENERAL
}

enum TypeBuilding {
  R2
  R3
  R4
  VILLA
  COUR_COMMUNE
}

enum TypeUnite {
  STUDIO
  CHAMBRE
  CHAMBRE_SALON
  MAGASIN
}

enum StatutUnite {
  VACANT
  OCCUPE
  RESERVE
}

enum StatutTicket {
  NOUVEAU
  EN_COURS
  RESOLU
  FERME
}

model Otp {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otps")
}




model ClientOtp {
  id        Int      @id @default(autoincrement())
  clientId  Int      @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@map("client_otps")
}


model EtatLieux {
  id           Int       @id @default(autoincrement())
  leaseId      Int
  type         String    // "ENTREE" ou "SORTIE"
  date         DateTime  @default(now())
  description  String?
  photos       String[]  // Tableau de chemins d'images (URLs)
  signatureUrl String?   // URL de la signature client
  createdAt    DateTime  @default(now())
  
  lease        Lease     @relation(fields: [leaseId], references: [id], onDelete: Cascade)
}
