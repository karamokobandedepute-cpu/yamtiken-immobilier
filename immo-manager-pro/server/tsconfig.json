{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2022",
    "moduleResolution": "node",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "./**/*.js",
    "./**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "node_modules/**"
  ]
}
