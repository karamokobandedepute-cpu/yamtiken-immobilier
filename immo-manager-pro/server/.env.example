# ============================================
# IMMO MANAGER PRO - Configuration Serveur
# ============================================
# COPIER ce fichier en .env et remplir les valeurs
# Pour générer un JWT_SECRET fort : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Serveur
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DONNÉES SUPABASE + Prisma
# ============================================
# Recommandé pour Node/Prisma : mode « Session » (port 5432 sur l’hôte pooler)
# — évite les soucis de prepared statements du mode « Transaction » (6543 + pgbouncer=true).
# Copiez la chaîne « Session pooler » depuis Supabase : Project Settings > Database > Connection string.
#
# Exemple Session (pooler, port 5432) :
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30
#
# Alternative « Transaction » (plus de connexions courtes ; peut couper certaines requêtes Prisma) :
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require&connect_timeout=30
#
# DIRECT_URL : connexion directe (hôte db.[ref].supabase.co:5432) — obligatoire pour prisma migrate / db push
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://VOTRE_REF.supabase.co
SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_KEY=votre_service_key

# ============================================
# JWT (Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# ============================================
JWT_SECRET=remplacer_par_un_secret_de_64_caracteres_hex
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
CLIENT_URL=http://localhost:5173

# ============================================
# UPLOAD
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ============================================
# EMAIL (optionnel)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ============================================
# SUPER ADMIN
# ============================================
SUPER_ADMIN_EMAIL=munokolive@gmail.com

# ============================================
# ALERTES AUTOMATIQUES
# ============================================
ALERT_EMAIL=munokolive@gmail.com
ALERT_REFRESH_INTERVAL=5
