# ==========================================
# CONFIGURATION GLOBALE - YAMTIKEN (.env.example)
# ==========================================
# Copiez ce fichier en '.env' et remplacez les valeurs par les vÃ´tres.

# --- SERVEUR (BACKEND) ---
PORT=5000
NODE_ENV=development

# Base de donnÃ©es (Supabase / PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/db
DIRECT_URL=postgresql://user:password@host:5432/db

# Supabase (PartagÃ©)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=votre_anon_key
SUPABASE_SERVICE_KEY=votre_service_key

# SÃ©curitÃ© et Authentification
JWT_SECRET=votre_super_secret_jwt
JWT_EXPIRES_IN=100y

# Configuration du Backend
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Notifications et Alertes
SUPER_ADMIN_EMAIL=admin@example.com
ALERT_EMAIL=admin@example.com
ALERT_REFRESH_INTERVAL=5
GMAIL_APP_PASSWORD=votre_mot_de_passe_app_gmail

# --- CLIENT (FRONTEND) ---
# Proxy relatif vers l'API du backend
VITE_API_URL=/api
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_anon_key
